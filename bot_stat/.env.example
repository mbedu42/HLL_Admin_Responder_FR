# Copy this file to .env and fill in the server-specific values.
# Every default can be overridden inside an individual server object.
BOT_STAT_CONFIG_JSON='{
  "defaults": {
    "refreshIntervalMs": 45000,
    "maxAttempts": 3,
    "fallbackMaxPlayers": 100,
    "maxMapLength": 16,
    "unknownMapText": "Map Inconnue",
    "statusTemplate": "📍 {map} | 🎮 {players}/{maxPlayers}",
    "unavailableText": "🔴 Serveur indisponible",
    "onlineStatus": "online",
    "offlineStatus": "dnd"
  },
  "servers": [
    {
      "id": "ww2",
      "enabled": false,
      "source": "crcon",
      "discordToken": "",
      "crcon": {
        "baseUrl": "http://127.0.0.1:7010",
        "publicInfoPath": "/api/get_public_info",
        "timeoutMs": 5000
      }
    },
    {
      "id": "vietnam",
      "enabled": false,
      "source": "crcon",
      "discordToken": "",
      "crcon": {
        "baseUrl": "http://127.0.0.1:7001",
        "publicInfoPath": "/api/get_public_info",
        "timeoutMs": 5000
      }
    }
  ]
}'
