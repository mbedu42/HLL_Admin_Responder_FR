DISCORD_ADMIN_ROLES=role_id_1,role_id_2,role_id_3
DISCORD_OUTAGE_USER_IDS=user_id_1,user_id_2

# Dynamic JSON array: add or remove complete objects to change the number of
# monitored game servers. Keep the surrounding single quotes.
GAME_SERVERS='[
  {
    "id": "ww2",
    "name": "HLL Classique",
    "rcon": {
